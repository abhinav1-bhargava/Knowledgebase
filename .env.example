# --- Embeddings: choose one provider ---------------------------------------
# Default is local_hf (no keys needed; model downloads on first use).
EMBEDDING_PROVIDER=local_hf
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# For Airtel internal BGE-M3 (requires VPN):
# EMBEDDING_PROVIDER=airtel_bge
# AIRTEL_EMBEDDING_BASE_URL=http://10.5.178.21:3397/v1
# AIRTEL_EMBEDDING_API_KEY=EMPTY
# EMBEDDING_MODEL=bge-m3

# For OpenAI SaaS:
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# --- LLM (used by query generation regardless of embedding provider) -------
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
LLM_MODEL=gpt-4o-mini

# --- Jira ------------------------------------------------------------------
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your.email@org.com
JIRA_API_TOKEN=placeholder
JIRA_PROJECT_KEY=POD

# --- Vector store + retrieval ----------------------------------------------
CHROMA_PATH=./chroma_db
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=8
CONFIDENCE_THRESHOLD=0.7
